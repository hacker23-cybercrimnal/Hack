clear

export USERNAME=" வெ. அர்ச்சணா"
export AREA="Puthur"
export DOB="21/08/2010"
# Colors
RED='\033[1;31m'
GREEN='\033[1;32m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Title
figlet ARCH LINUX | lolcat

# Info
echo -e "${GREEN}User      :${NC} $USERNAME" |lolcat
echo -e "${GREEN}Location  :${NC} $AREA" |lolcat
echo -e "${GREEN}DOB       :${NC} $DOB" |lolcat
echo -e "${CYAN}Device    :${NC} $(getprop ro.product.model)" |lolcat
echo -e "${YELLOW}Android   :${NC} $(getprop ro.build.version.release)" |lolcat
echo -e "${GREEN}Date      :${NC} $(date +"%d-%m-%Y")" |lolcat
echo -e "${CYAN}Time      :${NC} $(date +"%I:%M %p")" |lolcat
echo ""

# System Info
neofetch --ascii_distro arch --ascii_colors 4 4  --colors 9 2 3 5 4 6

alias LOGIN='clear && source ~/.bashrc'
alias LOGOUT='exit'

STORAGE=$(df -h /data | awk 'NR==2 {print $4}')
echo "Storage Free : $STORAGE"


